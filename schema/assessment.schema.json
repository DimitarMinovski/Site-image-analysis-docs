{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ericsson.internal/site-image-analysis/schema/assessment/1.0.0",
  "title": "Cabinet Free Space Assessment",
  "description": "The service's public output contract. Produced by applying a versioned rubric to a Cabinet Representation. Every numeric field here is computed arithmetically by the policy engine; no field in 'measurements' or 'verdict' is generated by a language model.",
  "type": "object",
  "required": ["schema_version", "rubric", "representation_ref", "measurements", "verdict", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },

    "rubric": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "CAB-FREE-SPACE" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },

    "representation_ref": {
      "type": "object",
      "required": ["image_sha256"],
      "additionalProperties": false,
      "properties": {
        "image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "site_id": { "type": ["string", "null"] },
        "cabinet_id": { "type": ["string", "null"] }
      }
    },

    "measurements": {
      "type": "object",
      "required": ["total_u", "occupied_u", "blanked_u", "open_u", "occluded_u",
                   "free_u", "largest_contiguous_free_u", "usable_free_u"],
      "additionalProperties": false,
      "properties": {
        "total_u": { "type": "integer", "minimum": 1 },
        "occupied_u": { "type": "integer", "minimum": 0 },
        "blanked_u": { "type": "integer", "minimum": 0 },
        "open_u": { "type": "integer", "minimum": 0 },
        "occluded_u": { "type": "integer", "minimum": 0 },
        "free_u": { "type": "integer", "minimum": 0,
          "description": "blanked_u + open_u. Occluded U are NOT included." },
        "largest_contiguous_free_u": { "type": "integer", "minimum": 0 },
        "usable_free_u": { "type": "integer", "minimum": 0,
          "description": "The figure that drives the verdict. Excludes runs that are reserved, obstructed, or required as clearance." },
        "reserved_u": { "type": "integer", "minimum": 0 },
        "missing_blanking_u": { "type": "integer", "minimum": 0 },
        "free_runs": {
          "type": "array",
          "description": "Every maximal run of available U, with the reason if it was excluded from usable_free_u. This is what makes a verdict explainable.",
          "items": {
            "type": "object",
            "required": ["u_from", "u_to", "usable"],
            "additionalProperties": false,
            "properties": {
              "u_from": { "type": "integer", "minimum": 1 },
              "u_to": { "type": "integer", "minimum": 1 },
              "usable": { "type": "boolean" },
              "excluded_reason": { "type": ["string", "null"], "enum": [
                "required_clearance", "cable_obstruction", "insufficient_depth", "reserved", null
              ] }
            }
          }
        }
      }
    },

    "airflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blanking_compliant": { "type": ["boolean", "null"] },
        "top_clearance_ok": { "type": ["boolean", "null"] },
        "cable_obstruction": { "type": ["string", "null"], "enum": ["none", "low", "moderate", "high", null] }
      }
    },

    "verdict": {
      "type": "object",
      "required": ["value", "basis", "rule_id"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "enum": ["adequate", "limited", "critical", "borderline", "abstained"] },
        "rule_id": { "type": "integer", "minimum": 1, "maximum": 10,
          "description": "Which row of the section 7 decision table fired. Makes every verdict traceable to a written rule." },
        "basis": { "type": "string",
          "description": "Plain-language statement of the arithmetic that triggered the rule." },
        "abstain_reason": { "type": ["string", "null"], "enum": [
          "quality_gate_failed", "scale_unreliable", "total_u_mismatch",
          "excessive_occlusion", "frame_incomplete", null
        ] },
        "reshoot_instruction": { "type": ["string", "null"],
          "description": "Actionable text for the installer when abstaining." }
      }
    },

    "uncertainty": {
      "type": "object",
      "required": ["free_u_low", "free_u_high", "verdict_stable_across_interval"],
      "additionalProperties": false,
      "properties": {
        "free_u_low": { "type": "integer", "minimum": 0 },
        "free_u_high": { "type": "integer", "minimum": 0 },
        "verdict_stable_across_interval": { "type": "boolean",
          "description": "False means the verdict changes across the plausible range, so precision would be a false claim. Routes to BORDERLINE." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1,
          "description": "Must be calibrated against the gold set before it is shown to a reviewer." }
      }
    },

    "not_determinable": {
      "type": "array",
      "description": "Explicit list of what this assessment cannot conclude, with the blocking clause. Prevents a U-count from being read as expansion capacity.",
      "items": {
        "type": "object",
        "required": ["aspect", "clause_id"],
        "additionalProperties": false,
        "properties": {
          "aspect": { "type": "string", "enum": ["usable_depth", "power_capacity", "port_capacity", "rear_occupancy"] },
          "clause_id": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "severity", "text"],
        "additionalProperties": false,
        "properties": {
          "clause_id": { "type": "string",
            "description": "Must exist in the rubric clause catalogue. Never renumbered." },
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "info"] },
          "text": { "type": "string" },
          "recommendation": { "type": ["string", "null"] },
          "evidence": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "u_span": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
              "bbox_px": { "type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
            }
          },
          "source": { "type": "string", "enum": ["policy_engine", "vlm_judgement"],
            "description": "Which layer raised it. Deterministic findings and interpretive ones must be distinguishable in review." }
        }
      }
    },

    "narrative": {
      "type": ["string", "null"],
      "description": "Human-readable summary generated FROM the finished verdict. Never permitted to influence or produce the verdict."
    },

    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "enum": [
          "verdict_critical", "abstained", "borderline", "random_sample", null
        ], "description": "random_sample matters: reviewing only flagged cases makes false negatives invisible." },
        "status": { "type": "string", "enum": ["pending", "confirmed", "corrected", "rejected"] },
        "reviewer_id": { "type": ["string", "null"] },
        "corrected_verdict": { "type": ["string", "null"], "enum": ["adequate", "limited", "critical", null] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["produced_at", "policy_engine_version"],
      "additionalProperties": false,
      "properties": {
        "produced_at": { "type": "string", "format": "date-time" },
        "policy_engine_version": { "type": "string" },
        "perception_version": { "type": ["string", "null"] },
        "vlm_model": { "type": ["string", "null"] },
        "vlm_prompt_version": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] }
      }
    }
  }
}
