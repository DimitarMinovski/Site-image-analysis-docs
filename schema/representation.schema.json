{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ericsson.internal/site-image-analysis/schema/representation/1.0.0",
  "title": "Cabinet Representation",
  "description": "Policy-free structured model of one cabinet at one point in time, derived from one or more images. Contains NO verdicts and NO rubric knowledge. This is the contract between the perception layer and the reasoning layer: reasoning can be tested against hand-written instances of this document with no images present, and stored instances can be re-scored against a new rubric without reprocessing pixels.",
  "type": "object",
  "required": ["schema_version", "image", "site", "quality", "scale", "u_map", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },

    "image": {
      "type": "object",
      "required": ["sha256", "width_px", "height_px"],
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$",
          "description": "Content hash. The anchor for reproducibility." },
        "captured_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["ECO", "installer_upload", "manual_import", "test_fixture"] },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 }
      }
    },

    "site": {
      "type": "object",
      "required": ["site_id", "cabinet_id"],
      "additionalProperties": false,
      "properties": {
        "site_id": { "type": "string" },
        "cabinet_id": { "type": "string",
          "description": "Stable across visits. Required for change detection over time." },
        "cabinet_type": { "type": ["string", "null"] },
        "cabinet_total_u_declared": { "type": ["integer", "null"], "minimum": 1, "maximum": 60,
          "description": "From the cabinet type record, NOT from the image. Cross-checked against measurement by clause GEOM-1.0." }
      }
    },

    "quality": {
      "type": "object",
      "required": ["gate_passed", "issues"],
      "additionalProperties": false,
      "properties": {
        "gate_passed": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string", "enum": [
            "frame_incomplete_top", "frame_incomplete_bottom", "rails_not_detected",
            "excessive_glare", "underexposed", "motion_blur", "door_obstructing",
            "oblique_angle_excessive", "resolution_insufficient"
          ] }
        },
        "sharpness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "glare_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "face_visible_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },

    "rectification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "boolean" },
        "homography_rmse_px": { "type": ["number", "null"], "minimum": 0 },
        "estimated_yaw_deg": { "type": ["number", "null"] }
      }
    },

    "scale": {
      "type": "object",
      "required": ["px_per_u", "method", "confidence"],
      "additionalProperties": false,
      "properties": {
        "px_per_u": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "method": { "type": "string", "enum": [
          "rail_hole_pattern", "known_equipment_height", "declared_cabinet_height", "unavailable"
        ], "description": "rail_hole_pattern is preferred: periodic and dimensionally fixed at 15.875/15.875/12.7 mm per EIA-310." },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "residual_pct": { "type": ["number", "null"], "minimum": 0,
          "description": "Fit residual of the periodic pattern. A low-residual fit is the strongest evidence that scale is trustworthy." },
        "measured_total_u": { "type": ["integer", "null"], "minimum": 1, "maximum": 60 }
      }
    },

    "u_map": {
      "type": "array",
      "minItems": 1,
      "description": "Contiguous, non-overlapping, ascending spans covering every U from 1 to measured_total_u with no gaps.",
      "items": {
        "type": "object",
        "required": ["u_from", "u_to", "state", "confidence"],
        "additionalProperties": false,
        "properties": {
          "u_from": { "type": "integer", "minimum": 1 },
          "u_to": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "enum": ["occupied", "blanked", "open", "occluded"] },
          "occupied_class": { "type": ["string", "null"], "enum": [
            "equipment", "shelf", "pdu", "cable_manager", "patch_panel", "unknown_hardware", null
          ], "description": "unknown_hardware still means occupied. Never free." },
          "equipment_model": { "type": ["string", "null"] },
          "equipment_u_height_catalogue": { "type": ["integer", "null"], "minimum": 1 },
          "occlusion_cause": { "type": ["string", "null"], "enum": [
            "cable_bundle", "glare", "shadow", "out_of_frame", "door", "other", null
          ] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox_px": {
            "type": ["array", "null"],
            "minItems": 4, "maxItems": 4,
            "items": { "type": "number" },
            "description": "[x1,y1,x2,y2] in rectified image coordinates."
          }
        }
      }
    },

    "obstructions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "confidence"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["cable_bundle", "loose_cable", "debris", "non_rack_item"] },
          "u_span": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
          "coverage_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1,
            "description": "Fraction of the spanned U area visually obstructed. Severity is assigned by the rubric, not here." },
          "bbox_px": { "type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "clearance_observations": {
      "type": "array",
      "description": "Raw observations only. Whether a clearance is SUFFICIENT is a rubric decision.",
      "items": {
        "type": "object",
        "required": ["above_u", "free_u_above"],
        "additionalProperties": false,
        "properties": {
          "above_u": { "type": "integer", "minimum": 1 },
          "equipment_model": { "type": ["string", "null"] },
          "free_u_above": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "depth": {
      "type": "object",
      "required": ["determinable"],
      "additionalProperties": false,
      "properties": {
        "determinable": { "type": "boolean" },
        "reason": { "type": ["string", "null"],
          "description": "e.g. single_frontal_image. Honesty field: a 2D front view cannot measure depth." }
      }
    },

    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "power_determinable": { "type": "boolean" },
        "spare_breaker_positions": { "type": ["integer", "null"], "minimum": 0 },
        "ports_determinable": { "type": "boolean" },
        "spare_ports": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "provenance": {
      "type": "object",
      "required": ["perception_version", "produced_at"],
      "additionalProperties": false,
      "properties": {
        "perception_version": { "type": "string" },
        "detector_version": { "type": ["string", "null"] },
        "vlm_model": { "type": ["string", "null"],
          "description": "Set when a vision model contributed to the u_map, e.g. resolving occlusion." },
        "vlm_prompt_version": { "type": ["string", "null"] },
        "produced_at": { "type": "string", "format": "date-time" },
        "pipeline_stages": {
          "type": "array",
          "items": { "type": "string", "enum": ["A_rectify", "B_scale", "C_detect", "E_vlm_assist"] }
        }
      }
    }
  }
}
